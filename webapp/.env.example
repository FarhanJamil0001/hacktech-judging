# Required for /admin login
ADMIN_PASSWORD=changeme

# Optional in dev — required to publish to GitHub from the admin UI.
# PAT needs `repo` (or `contents:write`) scope on the target repo.
GITHUB_TOKEN=
GITHUB_REPO=your-username/HackTechJudging
GITHUB_BRANCH=main
GITHUB_DATA_PATH=webapp/data/schedule.json
